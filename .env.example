APP_NAME="SLT-MOBITEL Churn Analytics"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mongodb

# --- MongoDB (the only application database used by this prototype) ---
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_HOST=127.0.0.1
MONGODB_PORT=27017
MONGODB_DATABASE=slt_mobitel_churn
MONGODB_USERNAME=
MONGODB_PASSWORD=

# --- Synthetic data volume (see config/churn-analytics.php) ---
# Lower these for a faster local run; `php artisan churn:reseed` honours them.
CHURN_SEED_CUSTOMERS=7500
CHURN_SEED_USAGE_MONTHS=18
CHURN_SEED_CHURN_RATE=0.315
CHURN_SEED_CHUNK=1000

# The mongodb/laravel-mongodb query grammar does not implement insertOrIgnore,
# which the database session and cache stores both rely on. Sessions and cache
# therefore use file storage; all application data still lives in MongoDB.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
